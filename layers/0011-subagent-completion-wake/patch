+            }
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("queued triggering mail should start a successor turn");
+
+    worker_thread
+        .session
+        .abort_all_tasks(TurnAbortReason::Interrupted)
+        .await;
+}
