+
+    let current = supervisor_runtime.claim_continuation();
+    settle_persisted_wake(&parent, &goal, &supervisor_runtime, current).await;
+
+    assert_eq!(
+        store
+            .get_goal_wake(parent.thread_id)
+            .await
+            .expect("read settled wake"),
+        None
+    );
+}
