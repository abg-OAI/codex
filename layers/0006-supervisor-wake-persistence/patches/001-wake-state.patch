+        goal_id: "new-goal".to_string(),
+        goal_objective: "new objective".to_string(),
+        goal_updated_at_ms: 20,
+        wake_at_ms: 200,
+    };
+
+    store.set_goal_wake(&old).await?;
+    store.set_goal_wake(&replacement).await?;
