+            AND snooze_delay_seconds IS NOT NULL
+            AND snooze_delay_seconds > 0
+            AND snooze_reason IS NOT NULL
+            AND length(trim(snooze_reason)) > 0
+        ) OR (
+            action_kind != 'snooze'
+            AND snooze_delay_seconds IS NULL
+            AND snooze_reason IS NULL
+        )
+    )
