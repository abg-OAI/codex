+            tool.name.clone()
+        })
+        .collect::<Vec<_>>();
+
+    assert_eq!(
+        names,
+        vec![
+            "supervisor_followup_parent",
+            "supervisor_snooze",
+            "supervisor_compact_parent_context",
+            "supervisor_close_self",
