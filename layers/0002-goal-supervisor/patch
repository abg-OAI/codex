+                    .to_string(),
+                ),
+                responses::ev_completed("supervisor-action"),
+            ]),
+            responses::sse(vec![
+                responses::ev_response_created("supervisor-finished"),
+                responses::ev_assistant_message("supervisor-message", "Snoozed."),
+                responses::ev_completed("supervisor-finished"),
+            ]),
+        ],
+    )
+    .await;
