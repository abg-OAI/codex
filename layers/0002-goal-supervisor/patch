+        action_at_ms: 10,
+        snooze_count: 1,
+        snoozed_seconds: 60,
+    };
+    let replacement = GoalSupervisorContinuity {
+        thread_id,
+        goal_id: "goal-b".to_string(),
+        action: GoalSupervisorAction::Compact,
+        action_at_ms: 20,
+        snooze_count: 0,
+        snoozed_seconds: 0,
