+/// Orders published Luna generations numerically rather than by display name.
+fn luna_generation(model: &str) -> Option<Vec<u32>> {
+    model
+        .strip_prefix("gpt-")?
+        .strip_suffix("-luna")?
+        .split('.')
+        .map(str::parse)
+        .collect::<Result<Vec<_>, _>>()
+        .ok()
+}
