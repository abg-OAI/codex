+                        "objective": "ship the release",
+                        "token_budget": 20_000,
+                    })
+                    .to_string(),
+                ),
+                responses::ev_completed("create-goal"),
+            ]),
+            responses::sse(vec![
+                responses::ev_response_created("edit-goal"),
+                responses::ev_function_call_with_namespace(
