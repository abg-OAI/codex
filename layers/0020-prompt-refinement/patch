+        r#"{"refinement":"ok","extra":true}"#,
+    ] {
+        assert!(parse_output(text).is_err());
+    }
+    assert!(
+        parse_output(&serde_json::json!({"refinement": "a".repeat(OUTPUT_BYTES)}).to_string())
+            .is_err()
