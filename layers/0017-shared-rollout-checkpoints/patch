+    assert!(
+        !context.items[2..]
+            .iter()
+            .any(|item| matches!(item, RolloutItem::ResponseItem(_)))
+    );
+    child.thread.shutdown_and_wait().await.unwrap();
+    source.thread.shutdown_and_wait().await.unwrap();
+}
