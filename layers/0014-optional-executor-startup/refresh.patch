+#[tokio::test]
+async fn inventory_timeout_keeps_an_admitted_executor_available() {
+    let home = TempDir::new().unwrap();
+    let mut config = config(&home).await;
+    config.ephemeral = true;
+    config.project_doc_max_bytes = 0;
+    let manager = Arc::new(EnvironmentManager::default_for_tests());
+    let (url, inventory_started, _server) = executor(ExecutorBehavior::StallInventory).await;
+    manager
+        .upsert_environment("remote".into(), url, None)
+        .unwrap();
+    let mut inputs = startup(
+        manager,
+        vec![selection("local", &config), selection("remote", &config)],
+    );
+    inputs.executor_discovery = Some(Arc::default());
+    let mut init = ExtensionDataInit::new();
+    record_selection_intent(&mut init, true);
+    let _clock_guard = freeze_clock();
+    let mut task =
+        tokio::spawn(async move { prepare(&config, ThreadId::new(), false, &init, inputs).await });
+    tokio::select! {
+        started = inventory_started => started.expect("executor received inventory request"),
+        _ = &mut task => panic!("admission finished before prewarming the inventory"),
+    }
+    tokio::time::advance(STARTUP_BUDGET + Duration::from_millis(1)).await;
+    let admitted = task.await.unwrap().unwrap();
+    assert_eq!(
+        admitted
+            .inherited
+            .turn_environments()
+            .next()
+            .unwrap()
+            .selection
+            .environment_id,
+        "remote"
+    );
+    assert!(admitted.warnings.is_empty());
+}
